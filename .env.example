# ============================================================
#  QQ 群聊机器人配置（复制本文件为 .env 后填写）
#  文档：README.md
# ============================================================

# ---------- 必填：QQ 机器人开放平台凭证 ----------
# 在 https://q.qq.com 创建机器人后，于「开发设置」中获取
BOT_APP_ID=
BOT_APP_SECRET=

# ---------- 必填：大模型 API（AI 聊天用） ----------
# 以 DeepSeek 为例：https://platform.deepseek.com 创建 API Key
# 兼容任何 OpenAI Chat Completions 协议的服务（通义、Kimi、智谱、本地 Ollama 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 人设 / 系统提示词。留空使用内置默认值。
# LLM_SYSTEM_PROMPT=你是 QQ 群里的聊天机器人小Q，说话简短自然，像群友一样。

# ---------- 可选：行为调优 ----------
# 机器人名字（仅用于日志和默认人设）
# BOT_NAME=小Q
# 每个会话保留的历史轮数（一问一答算一轮）
# LLM_HISTORY_TURNS=10
# 单条回复最大字数，超过会分条发送（QQ 群单条文字有长度上限）
# REPLY_MAX_CHARS=700
# 单次最多分几条（被动回复每条消息最多 5 次）
# REPLY_MAX_CHUNKS=3
# 同一群两条消息之间的最小间隔（毫秒）。官方限制单群 20 条/分钟，3200ms 约 18.7 条/分钟
# REPLY_MIN_INTERVAL_MS=3200
# 只响应这些群（群 openid，逗号分隔）。留空表示不限制。
# ALLOW_GROUPS=
# 日志级别：debug | info | warn | error
# LOG_LEVEL=info

# ---------- 高级：一般不需要改 ----------
# 官方接口根地址
# QQ_API_BASE=https://api.bot.qq.com
# 仅测试用：覆盖 token / 网关地址
# QQ_TOKEN_URL=
# QQ_GATEWAY_URL=
# 会话记忆存放目录
# DATA_DIR=data
